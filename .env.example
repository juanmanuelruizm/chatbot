# Copia este fichero a .env y ajusta los valores que quieras sobrescribir.
# Todas las variables son opcionales: si no se definen, se usan los valores
# por defecto indicados aquí.

# --- Modelos (Ollama) ---
CHATBOT_MODEL=qwen2.5:7b
CHATBOT_EMBEDDING_MODEL=qwen2.5:7b

# --- Agent loop ---
# Máximo de iteraciones de herramientas por turno (evita bucles infinitos).
CHATBOT_MAX_TOOL_ROUNDS=10

# --- Tools ---
CHATBOT_WEB_MAX_RESULTS=5
CHATBOT_CODE_TIMEOUT=10
CHATBOT_RAG_TOP_K=5

# --- RAG / chunking ---
CHATBOT_CHUNK_SIZE=500
CHATBOT_CHUNK_OVERLAP=100
CHATBOT_COLLECTION=documents

# --- Rutas (por defecto, relativas a la raíz del proyecto) ---
# CHATBOT_DOCUMENTS_DIR=documents
# CHATBOT_CHROMA_DIR=chroma_db

# Directorio base permitido para las tools de ficheros (sandbox).
# Por defecto, el directorio de trabajo actual.
# CHATBOT_ALLOWED_BASE_DIR=.
